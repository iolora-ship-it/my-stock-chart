# このファイルをコピーして .streamlit/secrets.toml を作成し、
# 実際のAPIキーを入力してください（secrets.toml はGitにコミットしないでください）。
#
# EDINET APIキーの取得方法:
#   1. https://api.edinet-fsa.go.jp/api/v2/ (EDINET API仕様書のページ) から
#      利用者登録を行い、APIキー(Subscription-Key)を取得する
#   2. 取得したキーを下の行に貼り付ける
#
# Streamlit Community Cloudで公開している場合は、このファイルではなく
# アプリの管理画面 → Settings → Secrets に同じ内容を貼り付けてください。

EDINET_API_KEY = "ここに取得したAPIキーを入力"
